{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dda.example/contracts/autotrader/market-series-v1.schema.json",
  "title": "DDA AutoTrader Market Series v1",
  "description": "Normalized OHLCV series for descriptive analysis. A bar timestamp is its UTC close time. This contract does not authorize trading.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "instrument", "timeframe", "data_mode", "source", "retrieved_at", "bars"],
  "properties": {
    "contract_version": { "const": "dda.market-series.v1" },
    "instrument": {
      "type": "object",
      "additionalProperties": false,
      "required": ["symbol", "venue", "asset_class", "currency"],
      "properties": {
        "symbol": { "type": "string", "minLength": 1, "maxLength": 32 },
        "venue": { "type": "string", "minLength": 1, "maxLength": 32 },
        "asset_class": { "type": "string", "minLength": 1, "maxLength": 32 },
        "currency": { "type": "string", "minLength": 1, "maxLength": 32 }
      }
    },
    "timeframe": { "enum": ["1m", "5m", "15m", "30m", "1h", "4h", "1d", "1w"] },
    "data_mode": { "enum": ["snapshot", "historical", "synthetic"] },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 100 },
        "kind": { "enum": ["provider", "historical_import", "synthetic_fixture"] },
        "license_ref": { "type": "string", "maxLength": 200 },
        "provider_timestamp": { "type": "string", "format": "date-time" }
      }
    },
    "retrieved_at": { "type": "string", "format": "date-time" },
    "bars": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["timestamp", "open", "high", "low", "close", "volume"],
        "properties": {
          "timestamp": { "type": "string", "format": "date-time", "description": "UTC time at which the candle closed." },
          "open": { "type": "number", "exclusiveMinimum": 0 },
          "high": { "type": "number", "exclusiveMinimum": 0 },
          "low": { "type": "number", "exclusiveMinimum": 0 },
          "close": { "type": "number", "exclusiveMinimum": 0 },
          "volume": { "type": "number", "minimum": 0 }
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "data_mode": { "const": "snapshot" } } },
      "then": { "properties": { "source": { "properties": { "kind": { "const": "provider" } } } } }
    },
    {
      "if": { "properties": { "data_mode": { "const": "historical" } } },
      "then": { "properties": { "source": { "properties": { "kind": { "const": "historical_import" } } } } }
    },
    {
      "if": { "properties": { "data_mode": { "const": "synthetic" } } },
      "then": { "properties": { "source": { "properties": { "kind": { "const": "synthetic_fixture" } } } } }
    }
  ]
}
