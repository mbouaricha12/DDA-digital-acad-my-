{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dda.example/contracts/autotrader/order-recommendation-v2.schema.json",
  "title": "DDA AutoTrader Order Recommendation v2",
  "description": "Analysis-only technical candidate with separate hypothetical ATR reference levels and optional caller-assumption-based net reward-to-risk. No level is executable and the contract never authorizes execution.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "mode",
    "status",
    "rule_id",
    "analysis_contract_version",
    "signal_card",
    "order_recommendation",
    "order_plan",
    "plan_checks",
    "risk_check",
    "simulation",
    "manual_execution_notice",
    "transaction_request_disposition",
    "execution_enabled",
    "is_trade_approval",
    "validation_errors",
    "limitations"
  ],
  "properties": {
    "contract_version": {
      "const": "dda.order-recommendation.v2"
    },
    "mode": {
      "const": "analysis"
    },
    "status": {
      "enum": [
        "blocked",
        "insufficient_data",
        "no_setup",
        "candidate_generated"
      ]
    },
    "rule_id": {
      "const": "dda.trend-confirmation.v1"
    },
    "analysis_contract_version": {
      "const": "dda.market-analysis.v2"
    },
    "signal_card": {
      "$ref": "#/$defs/signalCard"
    },
    "order_recommendation": {
      "oneOf": [
        {
          "$ref": "#/$defs/orderRecommendation"
        },
        {
          "type": "null"
        }
      ]
    },
    "order_plan": {
      "const": null
    },
    "plan_checks": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "risk_check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseline",
        "projected"
      ],
      "properties": {
        "baseline": {
          "oneOf": [
            {
              "$ref": "#/$defs/riskSummary"
            },
            {
              "type": "null"
            }
          ]
        },
        "projected": {
          "oneOf": [
            {
              "$ref": "#/$defs/riskSummary"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "simulation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "data_mode",
        "status"
      ],
      "properties": {
        "data_mode": {
          "const": "simulation"
        },
        "status": {
          "enum": [
            "not_run",
            "projected_exposure_within_configured_limits"
          ]
        },
        "candidate_exposure_is_caller_supplied": {
          "type": "boolean"
        }
      }
    },
    "manual_execution_notice": {
      "type": "string",
      "minLength": 1
    },
    "transaction_request_disposition": {
      "const": null
    },
    "execution_enabled": {
      "const": false
    },
    "is_trade_approval": {
      "const": false
    },
    "validation_errors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/validationError"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "validationError": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "code",
        "message"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      }
    },
    "riskSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "policy_id",
        "snapshot_as_of",
        "breach_count",
        "breaches",
        "validation_errors"
      ],
      "properties": {
        "status": {
          "enum": [
            "within_configured_limits",
            "limits_exceeded",
            "invalid_input",
            "stale_snapshot"
          ]
        },
        "policy_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "snapshot_as_of": {
          "type": [
            "string",
            "null"
          ]
        },
        "breach_count": {
          "type": "integer",
          "minimum": 0
        },
        "breaches": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "metric",
              "scope",
              "observed",
              "limit",
              "unit"
            ],
            "properties": {
              "metric": {
                "type": "string"
              },
              "scope": {
                "type": "string"
              },
              "observed": {
                "type": "number"
              },
              "limit": {
                "type": "number"
              },
              "unit": {
                "type": "string"
              }
            }
          }
        },
        "validation_errors": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "code"
            ],
            "properties": {
              "path": {
                "type": "string"
              },
              "code": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metric",
        "value",
        "unit",
        "window_end"
      ],
      "properties": {
        "metric": {
          "type": "string"
        },
        "value": {
          "type": "number"
        },
        "unit": {
          "type": "string"
        },
        "window_end": {
          "type": [
            "string",
            "null"
          ]
        },
        "method": {
          "type": "string"
        }
      }
    },
    "signalCard": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "recommendation",
        "direction",
        "rule_id",
        "instrument",
        "data_cutoff",
        "market_data",
        "entry_conditions",
        "invalidation_conditions",
        "stop_logic",
        "target_logic",
        "reward_to_risk",
        "confidence",
        "supporting_evidence",
        "reason",
        "proposal_levels"
      ],
      "properties": {
        "status": {
          "enum": [
            "blocked",
            "insufficient_data",
            "no_setup",
            "long_candidate",
            "short_candidate"
          ]
        },
        "recommendation": {
          "enum": [
            "WAIT",
            "LONG_CANDIDATE",
            "SHORT_CANDIDATE"
          ]
        },
        "direction": {
          "enum": [
            "none",
            "long",
            "short"
          ]
        },
        "rule_id": {
          "const": "dda.trend-confirmation.v1"
        },
        "instrument": {
          "type": [
            "string",
            "null"
          ]
        },
        "data_cutoff": {
          "type": [
            "string",
            "null"
          ]
        },
        "market_data": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "data_mode",
                "source_id",
                "source_kind",
                "timeframe"
              ],
              "properties": {
                "data_mode": {
                  "enum": [
                    "historical",
                    "synthetic"
                  ]
                },
                "source_id": {
                  "type": "string"
                },
                "source_kind": {
                  "enum": [
                    "provider",
                    "historical_import",
                    "synthetic_fixture"
                  ]
                },
                "timeframe": {
                  "type": "string"
                }
              }
            }
          ]
        },
        "entry_conditions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "invalidation_conditions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "stop_logic": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "reason"
          ],
          "properties": {
            "status": {
              "enum": [
                "not_computed",
                "computed"
              ]
            },
            "reason": {
              "type": "string"
            }
          }
        },
        "target_logic": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "reason"
          ],
          "properties": {
            "status": {
              "enum": [
                "not_computed",
                "computed"
              ]
            },
            "reason": {
              "type": "string"
            }
          }
        },
        "reward_to_risk": {
          "oneOf": [
            {
              "$ref": "#/$defs/rewardToRisk"
            },
            {
              "type": "null"
            }
          ]
        },
        "confidence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "value"
          ],
          "properties": {
            "status": {
              "const": "not_scored"
            },
            "value": {
              "type": "null"
            }
          }
        },
        "supporting_evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "proposal_levels": {
          "$ref": "#/$defs/proposalLevels"
        }
      }
    },
    "orderRecommendation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proposal_status",
        "order_ready",
        "instrument",
        "side",
        "data_mode",
        "rule_id",
        "data_cutoff",
        "reference_close",
        "caller_supplied_exposure",
        "order_fields",
        "risk_check_status",
        "required_manual_review"
      ],
      "properties": {
        "proposal_status": {
          "const": "proposed_unsubmitted"
        },
        "order_ready": {
          "const": false
        },
        "instrument": {
          "type": "string"
        },
        "side": {
          "enum": [
            "long",
            "short"
          ]
        },
        "data_mode": {
          "const": "simulation"
        },
        "rule_id": {
          "const": "dda.trend-confirmation.v1"
        },
        "data_cutoff": {
          "type": "string"
        },
        "reference_close": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "currency",
            "timestamp",
            "executable",
            "basis"
          ],
          "properties": {
            "value": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "currency": {
              "type": "string"
            },
            "timestamp": {
              "type": "string"
            },
            "executable": {
              "const": false
            },
            "basis": {
              "const": "historical_or_synthetic_bar_close"
            }
          }
        },
        "caller_supplied_exposure": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "notional",
            "assumed_risk_amount",
            "currency",
            "source"
          ],
          "properties": {
            "notional": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "assumed_risk_amount": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "currency": {
              "type": "string"
            },
            "source": {
              "const": "caller_supplied_hypothetical"
            }
          }
        },
        "order_fields": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "quantity",
            "order_type",
            "entry",
            "stop_loss",
            "target",
            "time_in_force",
            "estimated_costs",
            "maximum_modeled_loss"
          ],
          "properties": {
            "quantity": {
              "type": "null"
            },
            "order_type": {
              "type": "null"
            },
            "entry": {
              "type": "null"
            },
            "stop_loss": {
              "type": "null"
            },
            "target": {
              "type": "null"
            },
            "time_in_force": {
              "type": "null"
            },
            "estimated_costs": {
              "type": "null"
            },
            "maximum_modeled_loss": {
              "type": "null"
            }
          }
        },
        "risk_check_status": {
          "const": "within_configured_limits"
        },
        "required_manual_review": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "proposalLevelValue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "price",
        "currency",
        "timestamp",
        "basis",
        "method_id",
        "executable",
        "reason"
      ],
      "properties": {
        "status": {
          "enum": [
            "not_defined_by_rule",
            "not_computable",
            "computed"
          ]
        },
        "price": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "number",
              "exclusiveMinimum": 0
            }
          ]
        },
        "currency": {
          "type": [
            "string",
            "null"
          ]
        },
        "timestamp": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "basis": {
          "enum": [
            "not_defined",
            "completed_bar_close_reference",
            "strategy_rule",
            "atr_model"
          ]
        },
        "method_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "executable": {
          "const": false
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "proposalTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_id",
        "status",
        "price",
        "currency",
        "timestamp",
        "basis",
        "method_id",
        "executable",
        "reason"
      ],
      "properties": {
        "target_id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "not_computable",
            "computed"
          ]
        },
        "price": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "currency": {
          "type": "string",
          "minLength": 1
        },
        "timestamp": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "basis": {
          "enum": [
            "completed_bar_close_reference",
            "strategy_rule",
            "atr_model"
          ]
        },
        "method_id": {
          "type": "string",
          "minLength": 1
        },
        "executable": {
          "const": false
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "rewardToRisk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "unit",
        "gross_ratio",
        "net_ratio",
        "method",
        "cost_model_id",
        "by_target",
        "reason",
        "net_status",
        "net_reason",
        "cost_model_reference",
        "cost_assumptions",
        "net_validation_errors"
      ],
      "properties": {
        "status": {
          "enum": [
            "not_defined_by_rule",
            "not_computable",
            "computed"
          ]
        },
        "unit": {
          "const": "ratio"
        },
        "gross_ratio": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "number",
              "exclusiveMinimum": 0
            }
          ]
        },
        "net_ratio": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "number"
            }
          ]
        },
        "method": {
          "type": [
            "string",
            "null"
          ]
        },
        "cost_model_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "by_target": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "target_id",
              "status",
              "gross_ratio",
              "net_ratio",
              "net_reward_amount",
              "net_risk_amount",
              "currency"
            ],
            "properties": {
              "target_id": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "enum": [
                  "not_computable",
                  "computed"
                ]
              },
              "gross_ratio": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "number",
                    "exclusiveMinimum": 0
                  }
                ]
              },
              "net_ratio": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "number"
                  }
                ]
              },
              "net_reward_amount": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "net_risk_amount": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "currency": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "net_status": {
          "enum": [
            "not_defined_by_rule",
            "not_supplied",
            "not_computable",
            "computed"
          ]
        },
        "net_reason": {
          "type": "string",
          "minLength": 1
        },
        "cost_model_reference": {
          "type": [
            "string",
            "null"
          ]
        },
        "cost_assumptions": {
          "oneOf": [
            {
              "$ref": "#/$defs/costAssumptions"
            },
            {
              "type": "null"
            }
          ]
        },
        "net_validation_errors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/validationError"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "not_defined_by_rule"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "gross_ratio": {
                "type": "null"
              },
              "net_ratio": {
                "type": "null"
              },
              "method": {
                "type": "null"
              },
              "cost_model_id": {
                "type": "null"
              },
              "by_target": {
                "maxItems": 0
              },
              "net_status": {
                "const": "not_defined_by_rule"
              },
              "cost_model_reference": {
                "type": "null"
              },
              "cost_assumptions": {
                "type": "null"
              },
              "net_validation_errors": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    },
    "proposalLevels": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version",
        "status",
        "entry",
        "stop_loss",
        "targets",
        "reward_to_risk",
        "executable",
        "reason",
        "method"
      ],
      "properties": {
        "contract_version": {
          "const": "dda.signal-levels.v1"
        },
        "status": {
          "enum": [
            "not_defined_by_rule",
            "not_computable",
            "computed"
          ]
        },
        "entry": {
          "$ref": "#/$defs/proposalLevelValue"
        },
        "stop_loss": {
          "$ref": "#/$defs/proposalLevelValue"
        },
        "targets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/proposalTarget"
          }
        },
        "reward_to_risk": {
          "$ref": "#/$defs/rewardToRisk"
        },
        "executable": {
          "const": false
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "method": {
          "oneOf": [
            {
              "$ref": "#/$defs/levelMethod"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "not_defined_by_rule"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "entry": {
                "properties": {
                  "status": {
                    "const": "not_defined_by_rule"
                  },
                  "price": {
                    "type": "null"
                  }
                }
              },
              "stop_loss": {
                "properties": {
                  "status": {
                    "const": "not_defined_by_rule"
                  },
                  "price": {
                    "type": "null"
                  }
                }
              },
              "targets": {
                "maxItems": 0
              },
              "reward_to_risk": {
                "properties": {
                  "status": {
                    "const": "not_defined_by_rule"
                  },
                  "gross_ratio": {
                    "type": "null"
                  },
                  "net_ratio": {
                    "type": "null"
                  },
                  "by_target": {
                    "maxItems": 0
                  }
                }
              },
              "method": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "not_computable"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "method": {
                "type": "null"
              },
              "entry": {
                "properties": {
                  "status": {
                    "const": "not_computable"
                  },
                  "price": {
                    "type": "null"
                  }
                }
              },
              "stop_loss": {
                "properties": {
                  "status": {
                    "const": "not_computable"
                  },
                  "price": {
                    "type": "null"
                  }
                }
              },
              "targets": {
                "maxItems": 0
              },
              "reward_to_risk": {
                "properties": {
                  "status": {
                    "const": "not_computable"
                  },
                  "gross_ratio": {
                    "type": "null"
                  },
                  "net_ratio": {
                    "type": "null"
                  },
                  "by_target": {
                    "maxItems": 0
                  }
                }
              }
            }
          }
        }
      ]
    },
    "costAssumptions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_id",
        "reference",
        "currency",
        "position_unit",
        "contract_multiplier",
        "holding_period_bars",
        "bars_per_year",
