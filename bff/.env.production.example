# Configure these in Render/Railway Secret Variables, never in Git.
BFF_ENVIRONMENT=production
SUPABASE_URL=https://vcvrjogdhdakrwmemoxl.supabase.co
SUPABASE_PUBLISHABLE_KEY=PASTE_FROM_SUPABASE_PROJECT_SETTINGS
SUPABASE_SERVICE_ROLE_KEY=PASTE_SERVER_ONLY_SECRET
# Must be base64url that decodes to exactly 32 bytes.
SESSION_ENCRYPTION_KEY=GENERATE_WITH_openssl_rand_base64_32
# Exact HTTPS origin of the authenticated frontend; no wildcard.
ALLOWED_ORIGINS=https://app.example.dda.academy
BFF_COOKIE_SECURE=true
# Verification/recovery redirect handled by the frontend deployment.
EMAIL_REDIRECT_TO=https://app.example.dda.academy/#access
SESSION_IDLE_MS=43200000
SESSION_ABSOLUTE_MS=2592000000
# Render/Railway inject PORT automatically; do not hard-code it unless the platform requires it.
# Chariow P4 — configure in the platform secret manager.
CHARIOW_API_KEY=PASTE_SERVER_ONLY_SECRET
CHARIOW_PULSE_SECRET=whsec_PASTE_SERVER_ONLY_SECRET
CHARIOW_PREMIUM_PRODUCT_IDS=prd_allowlisted_premium_product_id
CHARIOW_CHECKOUT_REDIRECT_URL=https://app.example.dda.academy/academy.html#membership

# AutoTrader initial ceilings; tune below the selected vendor plan and internal spend cap.
CHARIOW_AUTOTRADER_PRODUCT_IDS=
DDA_AUTOTRADER_USER_ANALYSES_PER_MINUTE=10
DDA_AUTOTRADER_USER_ANALYSES_PER_HOUR=50
DDA_AUTOTRADER_USER_ANALYSES_PER_DAY=200
# Leave blank until a provider is selected and its documented usage units are mapped.
DDA_AUTOTRADER_PROVIDER_ID=
DDA_AUTOTRADER_PROVIDER_REQUESTS_PER_MINUTE=10
DDA_AUTOTRADER_PROVIDER_REQUESTS_PER_DAY=200
DDA_AUTOTRADER_PROVIDER_UNITS_PER_MONTH=5000
# Enable only after licensing is approved; keep the API key in the platform secret manager.
TWELVE_DATA_API_KEY=
DDA_AUTOTRADER_TWELVE_DATA_LICENSE_REF=
DDA_AUTOTRADER_TWELVE_DATA_INSTRUMENTS_JSON=
