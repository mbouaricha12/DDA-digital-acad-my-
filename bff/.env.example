# Copy to a secret-managed environment; do not commit real values.
BFF_ENVIRONMENT=development
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
SUPABASE_SERVICE_ROLE_KEY=REPLACE_ME_SERVER_ONLY
SESSION_ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_BASE64URL_KEY
ALLOWED_ORIGINS=http://localhost:8744
BFF_COOKIE_SECURE=true
PORT=8744
EMAIL_REDIRECT_TO=http://localhost:8744/access
# Required when BFF_ENVIRONMENT=staging: set the known production references
# so startup refuses a staging config that reuses production Supabase or origins.
BFF_PRODUCTION_SUPABASE_URL=
BFF_PRODUCTION_ALLOWED_ORIGINS=
# Chariow P4 — server-only; use a secret manager in production.
CHARIOW_API_KEY=REPLACE_ME_SERVER_ONLY
CHARIOW_PULSE_SECRET=whsec_REPLACE_ME_SERVER_ONLY
CHARIOW_PREMIUM_PRODUCT_IDS=prd_replace_with_allowlisted_product_id
CHARIOW_CHECKOUT_REDIRECT_URL=http://localhost:8744/academy.html#membership

# AutoTrader rights and initial staging quota ceilings; provider calls stay disabled until selected.
CHARIOW_AUTOTRADER_PRODUCT_IDS=
DDA_AUTOTRADER_USER_ANALYSES_PER_MINUTE=10
DDA_AUTOTRADER_USER_ANALYSES_PER_HOUR=50
DDA_AUTOTRADER_USER_ANALYSES_PER_DAY=200
# Set to twelve-data whenever the Twelve Data allowlist is enabled; startup enforces this binding.
DDA_AUTOTRADER_PROVIDER_ID=
DDA_AUTOTRADER_PROVIDER_REQUESTS_PER_MINUTE=10
DDA_AUTOTRADER_PROVIDER_REQUESTS_PER_DAY=200
DDA_AUTOTRADER_PROVIDER_UNITS_PER_MONTH=5000
# Twelve Data is disabled until the data rights, license reference, and server-side instrument allowlist are approved.
TWELVE_DATA_API_KEY=
DDA_AUTOTRADER_TWELVE_DATA_LICENSE_REF=
DDA_AUTOTRADER_TWELVE_DATA_INSTRUMENTS_JSON=
